# ═══════════════════════════════════════════════════════════════════════════
#  Leanna — Modèle de configuration d'environnement
#
#  Copiez ce fichier vers `.env` puis renseignez vos propres valeurs :
#      cp .env.example .env            (Linux/macOS)
#      Copy-Item .env.example .env     (PowerShell)
#
#  ⚠️  NE JAMAIS mettre de secret réel ici. Ce fichier est versionné (git) et
#      sert UNIQUEMENT de modèle. Les vrais secrets vivent dans `.env`, qui est
#      ignoré par git (voir .gitignore : `.env*` sauf `!.env.example`).
#
#  Les variables laissées vides ("") utilisent leur valeur par défaut ou, pour
#  les secrets auto-générables (API token, clé maître), sont créées au premier
#  démarrage et écrites dans `.env`.
# ═══════════════════════════════════════════════════════════════════════════


# ─── Environnement & exécution ───────────────────────────────────────────────
# NODE_ENV : development | production | test
NODE_ENV="development"


# ─── Serveur & réseau ────────────────────────────────────────────────────────
# VITE_SERVER_PORT : port du serveur backend (HTTP/WebSocket). Défaut : 4000.
VITE_SERVER_PORT="4000"

# Leanna_LISTEN_HOST : interface d'écoute du serveur.
# Par défaut le serveur n'écoute que sur la boucle locale (127.0.0.1).
# Ne définissez "0.0.0.0" (accès LAN) qu'en connaissance de cause, et TOUJOURS
# combiné à un Leanna_API_TOKEN fort.
Leanna_LISTEN_HOST="127.0.0.1"

# DISABLE_HMR : "true" pour désactiver le Hot Module Replacement de Vite.
DISABLE_HMR=""

# APP_URL : URL publique où l'application est hébergée (liens, callbacks OAuth).
APP_URL=""


# ─── Sécurité & authentification ─────────────────────────────────────────────
# ⚠️  SECRETS — laissez vide pour auto-génération au premier démarrage, OU
#     renseignez votre propre valeur. NE COMMITEZ JAMAIS les valeurs réelles.
#
# Leanna_API_TOKEN : token requis pour l'API et les WebSockets.
# Si vide, un token sécurisé est généré au premier démarrage et écrit dans .env.
# IMPORTANT : accès complet au shell et au système de fichiers.
Leanna_API_TOKEN=""
# Jeton exposé au frontend Vite (doit correspondre à Leanna_API_TOKEN).
VITE_Leanna_API_TOKEN=""

# Leanna_MASTER_KEY : clé de chiffrement maître (API keys & données sensibles).
# Si vide, une clé est générée au premier démarrage. Sauvegardez-la : sans elle
# les données chiffrées sont irrécupérables. Format : base64 de 32 octets.
Leanna_MASTER_KEY=""

# LEANNA_AGENT_SECRET : secret HMAC (≥ 32 caractères) pour signer les agents
# dynamiques. Laisser vide désactive la vérification de signature.
LEANNA_AGENT_SECRET=""

# SANDBOX_EXIT_CODE : code à 6 chiffres pour sortir du mode sandbox.
SANDBOX_EXIT_CODE=""


# ─── Fournisseurs IA (Gemini / OpenRouter) ───────────────────────────────────
# GEMINI_API_KEY : clé pour l'API Gemini de Google. (secret)
GEMINI_API_KEY=""

# OpenRouter (optionnel) — OPENROUTER_API_KEY ou OPENROUTER_FREE_API_KEY. (secret)
OPENROUTER_API_KEY=""
OPENROUTER_FREE_API_KEY=""
OPENROUTER_MODEL=""
OPENROUTER_REFERER=""
OPENROUTER_TITLE=""
OPENROUTER_IMAGE_MODEL=""
# Modèle d'embedding OpenRouter (RAG). Vide = openai/text-embedding-3-small.
OPENROUTER_EMBEDDING_MODEL=""

# ─── Safety Gate Jev (modèle de décision via OpenRouter) ─────────────────────
#   off | audit | enforce
LEANNA_SAFETY_GATE="off"

# ─── Fallback inter-providers (Gemini <-> OpenRouter) ────────────────────────
LEANNA_PROVIDER_FALLBACK="true"
LEANNA_PROVIDER_BREAKER_THRESHOLD="3"
LEANNA_PROVIDER_BREAKER_COOLDOWN_MS="60000"


# ─── Comportement de l'assistant ─────────────────────────────────────────────
# ENABLE_CHAIN_OF_THOUGHT : true | false.
ENABLE_CHAIN_OF_THOUGHT="true"
FORCE_TIERED_TOOLS="true"
SELF_HEAL_READONLY="false"


# ─── Autonomie & skills ──────────────────────────────────────────────────────
# LEANNA_AUTONOMY_MODE : suggest | ask | auto (défaut).
LEANNA_AUTONOMY_MODE="auto"
# Autorise les actions « dangerous » en mode auto sans approbation. Défaut false.
LEANNA_AUTO_ALLOW_DANGEROUS="false"

# ── Moteur d'anticipation (observe → détecte → propose) ──
# Nombre de ticks heartbeat entre deux sweeps proactifs. Défaut 4.
LEANNA_ANTICIPATION_SWEEP_TICKS="4"
# Importance minimale (0–1) pour qu'une proposition soit surfacée. Défaut 0.4.
LEANNA_ANTICIPATION_MIN_IMPORTANCE="0.4"
# Seuil d'auto-lancement (0–1) : une proposition actionnable n'est transformée
# en mission que si importance >= ce seuil. Plus bas = plus proactif (et plus
# de missions auto-lancées). Défaut prudent 0.85.
LEANNA_ANTICIPATION_AUTOLAUNCH="0.85"
# Déduplication des propositions : TTL en ms de l'empreinte. Défaut 600000 (10 min).
LEANNA_ANTICIPATION_DEDUPE_TTL_MS="600000"
# Taille max de l'historique de propositions conservé en mémoire. Défaut 50.
LEANNA_ANTICIPATION_HISTORY_LIMIT="50"
# Réflexions de fond : ticks idle/sleep entre deux réflexions (0 = off). Défaut 3.
LEANNA_ANTICIPATION_REFLECT_TICKS="3"

# ── Autonomie encadrée (travail en lecture seule pendant les périodes calmes) ──
# Pendant les périodes calmes (heartbeat idle/sleep, aucune tâche active), Leanna
# lance une mission de DIAGNOSTIC en LECTURE SEULE (dry-run) plutôt qu'un simple
# message. Chaque lancement est borné par un budget horaire, un kill switch et
# un journal d'audit lisible (.Leanna/core/autonomy/audit.jsonl).
#
# Kill switch maître : "false" désactive totalement le travail idle autonome.
LEANNA_AUTONOMY_IDLE_WORK="true"
# Budget horaire glissant du travail auto-initié. 0 action/heure = désactivé.
LEANNA_AUTONOMY_MAX_ACTIONS_PER_HOUR="4"
LEANNA_AUTONOMY_MAX_TOKENS_PER_HOUR="200000"
LEANNA_AUTONOMY_MAX_COST_USD_PER_HOUR="0.5"
# Plafonds par mission idle (transmis au budget Executor/Telemetry).
LEANNA_AUTONOMY_PER_MISSION_MAX_TOKENS="60000"
LEANNA_AUTONOMY_PER_MISSION_MAX_COST_USD="0.15"
# Bornes de durée/plan d'un diagnostic idle : un diagnostic de fond reste court
# (timeout en ms, nombre max de sous-objectifs, concurrence max).
LEANNA_AUTONOMY_IDLE_TIMEOUT_MS="120000"
LEANNA_AUTONOMY_IDLE_MAX_SUBGOALS="2"
LEANNA_AUTONOMY_IDLE_MAX_CONCURRENT_GOALS="1"
# Bornes des missions autonomes réactives/anticipation. Ces missions sont
# INVESTIGATIVES (analyse + récupération/escalade, aucun fichier exigé) et
# restent bornées et courtes en arrière-plan (2,5 min, 2 sous-objectifs max).
LEANNA_AUTONOMY_MISSION_TIMEOUT_MS="150000"
LEANNA_AUTONOMY_MISSION_MAX_SUBGOALS="2"
LEANNA_AUTONOMY_MISSION_MAX_CONCURRENT_GOALS="1"


# ─── Présence vocale (annonces proactives) ───────────────────────────────────
LEANNA_VOICE_PRESENCE="false"
LEANNA_VOICE_PROACTIVE="true"
LEANNA_VOICE_PROACTIVE_THRESHOLD="0.7"


# ─── Routes de debug ─────────────────────────────────────────────────────────
# LEANNA_DEBUG_ROUTES : "true" | "false" | vide (exposées hors production).
# Laisser vide/false en production.
LEANNA_DEBUG_ROUTES="false"
# Hot-reload des skills custom (ms).
LEANNA_CUSTOM_SKILLS_RELOAD_INTERVAL_MS="30000"


# ─── Chaîne déterministe outil → agent (audits de boot) ──────────────────────
# warn | strict | off
Leanna_ATTRIBUTION_ENFORCEMENT="strict"
Leanna_CAPABILITY_ENFORCEMENT="strict"


# ─── Runtime autonome événementiel (valeurs en millisecondes) ────────────────
LEANNA_HEARTBEAT_ACTIVE_MS="15000"
LEANNA_HEARTBEAT_IDLE_MS="60000"
LEANNA_HEARTBEAT_SLEEP_MS="300000"
LEANNA_HEARTBEAT_IDLE_AFTER_MS="300000"
LEANNA_AUTONOMY_MAX_CONCURRENCY="2"
# LEANNA_AUTONOMY_MAX_CONCURRENT_CYCLES : cycles exécutifs simultanés max. Vide
# = 1 (sûr). 2 permet de traiter une anticipation pendant qu'une mission tourne.
LEANNA_AUTONOMY_MAX_CONCURRENT_CYCLES="2"
LEANNA_AUTONOMY_DEDUPE_TTL_MS="300000"
LEANNA_AUTONOMY_RETRY_DELAY_MS="1000"
# LEANNA_AUTONOMY_MAX_RETRIES : tentatives avant dead-letter. 1 évite de relancer
# en double une mission longue déjà coupée par le timeout.
LEANNA_AUTONOMY_MAX_RETRIES="1"
# LEANNA_AUTONOMY_TASK_TIMEOUT_MS : budget de la TÂCHE autonome (couche
# TaskManager). À garder >= au timeout de MISSION
# (LEANNA_AUTONOMY_MISSION_TIMEOUT_MS) + marge, pour que la borne interne de la
# mission se déclenche la première et que les logs restent cohérents.
LEANNA_AUTONOMY_TASK_TIMEOUT_MS="180000"
LEANNA_AUTONOMY_CIRCUIT_BREAKER_THRESHOLD="5"
LEANNA_AUTONOMY_CIRCUIT_BREAKER_COOLDOWN_MS="300000"


# ─── Permissions & garde-fous ────────────────────────────────────────────────
# Leanna_PERMISSION_MODE : enforce | audit | off.
Leanna_PERMISSION_MODE="enforce"
# Leanna_GRANTED_PERMISSIONS : CSV parmi read / write / network / exec / dangerous.
# Défaut recommandé : "read,write,network,exec" (tout sauf dangerous).
Leanna_GRANTED_PERMISSIONS="read,write,network,exec"

# ─── Dry-run global (simulation sans effet de bord) ──────────────────────────
Leanna_DRY_RUN="false"

# ─── Plugins / agents dynamiques ─────────────────────────────────────────────
# Allowlist de plugins (JSON : { "mon_agent.agent.js": "<sha256>" }).
LEANNA_PLUGIN_ALLOWLIST=""
# Exécution sandboxée via worker_threads.
LEANNA_PLUGIN_SANDBOX="true"

# ─── Limite de débit des écritures fichier ───────────────────────────────────
LEANNA_WRITE_RATE_LIMIT="60"
LEANNA_WRITE_WINDOW_MS="60000"
LEANNA_WRITE_RATE_MAX_WAIT_MS="5000"

# ─── Idempotence (ledger d'exécution + reprise sûre après crash) ─────────────
LEANNA_IDEMPOTENCY="false"


# ─── Système de missions (fiabilité & gouvernance) ───────────────────────────
# Les missions persistent TOUJOURS leur état localement sous `.Leanna/core`
# (reprise après crash garantie, même sans Supabase). Les deux flags ci-dessous
# activent des mécanismes de fiabilité supplémentaires, réversibles (vides/false
# = comportement par défaut inchangé).
#
# LEANNA_MISSION_EVIDENCE : "true"/"1" pour vérifier l'atteinte d'un objectif
# sur des FAITS (checks factuels dérivés des résultats de skills via
# l'EvidenceEngine) plutôt que sur le seul verdict du LLM. « La preuve prime sur
# la narration » : un seul contrôle factuel échoué interdit le succès. Le LLM ne
# sert plus que de repli quand aucun fait n'est exploitable. Défaut : désactivé.
LEANNA_MISSION_EVIDENCE="false"
#
# LEANNA_MISSION_SUPERVISED : "true"/"1" pour exécuter chaque mission SOUS
# GOUVERNANCE du LeannaSupervisor (autorité unique du cycle de vie). L'Executor
# devient le moteur ; le Supervisor possède l'état durable (CREATED → … →
# COMPLETED/FAILED/ESCALATED), les snapshots/rollback, le scellement de preuve
# et les décisions de récupération. Unifie les deux machines d'états. Défaut :
# désactivé (exécution directe par l'Executor).
LEANNA_MISSION_SUPERVISED="false"


# ─── Base de données Supabase ────────────────────────────────────────────────
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY : serveur (clé de service PRIVÉE).
# ⚠️  La service_role contourne la RLS : NE JAMAIS l'exposer au frontend ni la
#     réutiliser comme clé anon. (secret)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_ANON_KEY : clé publique (anon), distincte de la service_role.
SUPABASE_ANON_KEY=""
# Client navigateur (frontend Vite) — utilisez la clé ANON, jamais la service_role.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""


# ─── Redis & cache distribué (optionnel) ─────────────────────────────────────
REDIS_URL=""
LEANNA_KNOWLEDGE_CACHE_TTL_SECONDS="86400"
LEANNA_KNOWLEDGE_REDIS_URL=""
LEANNA_LOCK_REDIS_URL=""
LEANNA_EVENTBUS_REDIS_URL=""
LEANNA_EVENTBUS_STREAM="leanna:eventbus"
LEANNA_EVENTBUS_MAXLEN="10000"


# ─── Intégrations externes ───────────────────────────────────────────────────
# GITHUB_TOKEN : jeton d'accès GitHub. (secret)
GITHUB_TOKEN=""
# TELEGRAM_BOT_TOKEN : jeton du bot Telegram (via @BotFather). (secret)
TELEGRAM_BOT_TOKEN=""
# LEANNA_TELEGRAM_MIN_IMPORTANCE : seuil (0–1) d'importance d'une anticipation
# en deçà duquel aucun push Telegram proactif n'est envoyé. Défaut 0.6 (les
# « réflexions » idle d'importance 0.4 ne partent jamais).
LEANNA_TELEGRAM_MIN_IMPORTANCE="0.6"
# PUPPETEER_EXECUTABLE_PATH : chemin du navigateur pour l'automation (optionnel).
PUPPETEER_EXECUTABLE_PATH=""
# "true" pour ne pas télécharger Chromium au npm install (utilise le Chrome système).
PUPPETEER_SKIP_DOWNLOAD="true"
# AUTOMATION_ALLOWED_DOMAINS : domaines autorisés (CSV). Vide = permissif.
AUTOMATION_ALLOWED_DOMAINS=""
# BRAVE_SEARCH_API_KEY : clé API Brave Search (header X-Subscription-Token).
# Si définie, la recherche web (browser_web_search) utilise l'API Brave en
# priorité, avec repli automatique sur DuckDuckGo. Vide = DuckDuckGo seul. (secret)
BRAVE_SEARCH_API_KEY=""
# GRAPHIFY_BIN : chemin explicite vers le binaire graphify (optionnel).
GRAPHIFY_BIN=""


# ─── Journalisation & observabilité ──────────────────────────────────────────
# LOG_LEVEL : debug | info | warn | error.
LOG_LEVEL="info"
# OTEL_CONSOLE_EXPORT : "1"/"true" pour exporter les spans OpenTelemetry en console.
OTEL_CONSOLE_EXPORT=""
# TOOL_LOG_TRANSCRIPT : full | metadata | off.
TOOL_LOG_TRANSCRIPT="full"


# ─── Workspace ───────────────────────────────────────────────────────────────
# JARVIS_DEFAULT_WORKSPACE : workspace par défaut. Vide = dossier courant du process.
JARVIS_DEFAULT_WORKSPACE=""


# ─── Variables avancées (dev / Electron / tests) ─────────────────────────────
# ⚠️  Normalement À NE PAS définir à la main : elles sont injectées
#     automatiquement par l'exécution (Electron, scripts, tests), ou réservées
#     à des cas de debug. Documentées ici pour référence.
#
# Leanna_CONFIG_PATH : dossier où chercher .env / .gemini-keys.json / .Leanna.
#   Injecté par Electron (userData) au démarrage ; vide = dossier courant.
# Leanna_CONFIG_PATH=""
#
# ELECTRON_APP_PATH : chemin de l'app empaqueté, injecté par Electron.
# ELECTRON_APP_PATH=""
#
# ELECTRON_START_URL : URL chargée par la fenêtre Electron.
#   Défaut : http://127.0.0.1:<VITE_SERVER_PORT>.
# ELECTRON_START_URL=""
#
# ELECTRON_DEBUG : "1" pour activer le mode debug Electron (--inspect).
# ELECTRON_DEBUG=""
#
# Leanna_SELF_ROOT_OVERRIDE : force la racine projet (dev/CI UNIQUEMENT).
#   Ne jamais décommenter en production.
# Leanna_SELF_ROOT_OVERRIDE=""
#
# Leanna_SMOKE_URL : URL cible des scripts de smoke test (brain-smoke).
# Leanna_SMOKE_URL=""
